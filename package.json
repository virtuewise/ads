{
  "name": "printsync-ads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PrintSync Creative Operating System — a persistent brand-aware advertising engine",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "ads:create": "pnpm --filter @printsync/cli ads:create",
    "ads:daily": "pnpm --filter @printsync/cli ads:daily",
    "campaign:create": "pnpm --filter @printsync/cli campaign:create",
    "film:create": "pnpm --filter @printsync/cli film:create",
    "poster:create": "pnpm --filter @printsync/cli poster:create",
    "social:create": "pnpm --filter @printsync/cli social:create",
    "creative:judge": "pnpm --filter @printsync/cli creative:judge"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  }
}
